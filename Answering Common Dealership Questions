-- Create a primary marketing area based using the zip codes that the top 75% of sales originated from.

WITH sales_by_zip AS (
    SELECT 
        c.zip, 
        COUNT(*) AS units_sold
    FROM dealership_sales d
    LEFT JOIN customer_data c
        ON d.driver_id = c.driver_id
    WHERE c.zip IS NOT NULL
    GROUP BY c.zip
), ranked_sales AS (
    SELECT 
        zip, 
        units_sold, 
        CUME_DIST() OVER (ORDER BY units_sold DESC) AS sales_distribution
    FROM sales_by_zip
)
SELECT 
    zip, 
    units_sold,
    CASE 
        WHEN sales_distribution <= 0.75 THEN 'TRUE' 
        ELSE 'FALSE' 
    END AS in_pma
FROM ranked_sales
ORDER BY units_sold DESC;

-- Calculate the dealership average for days on lot. What makes sell quicker on average and by how many days?

WITH dealership_avg AS (
    SELECT AVG(CAST(days_on_lot AS FLOAT)) AS avg_dealership_days
    FROM dealership_sales
)
SELECT 
    make, 
    ROUND(AVG(CAST(days_on_lot AS FLOAT)), 2) AS avg_days_on_lot,
    ROUND((SELECT avg_dealership_days FROM dealership_avg) - AVG(CAST(days_on_lot AS FLOAT)), 2) 
    AS days_below_average
FROM dealership_sales
CROSS JOIN dealership_avg
GROUP BY make
HAVING AVG(CAST(days_on_lot AS FLOAT)) < (SELECT avg_dealership_days FROM dealership_avg)
ORDER BY days_below_average DESC;

-- What are the 10 worst days of the month for sales?

SELECT TOP 10 WITH TIES
	DAY(deal_date) AS day_of_month, 
	COUNT(*) AS number_of_sales
FROM dealership_sales
WHERE deal_date IS NOT NULL
GROUP BY DAY(deal_date)
ORDER BY number_of_sales ASC;

-- Which offbrands did we sell the most of?

SELECT 
	make, 
	count(*) as number_of_sales
FROM dealership_sales
WHERE LOWER(make) != 'ford'
GROUP BY make
ORDER BY number_of_sales DESC;

-- What is the top vehicle type by zip code. Prioritize the zip codes with the most sales.

WITH ranked_vehicle_types AS (
    SELECT 
        c.zip, 
        d.vehicle_type, 
        COUNT(*) AS sales_count,
        RANK() OVER (PARTITION BY c.zip ORDER BY COUNT(*) DESC) AS rank_per_zip,
        COUNT(*) OVER (PARTITION BY c.zip) AS total_sales_per_zip
    FROM customer_data c
    JOIN dealership_sales d ON c.driver_id = d.driver_id
    WHERE c.zip IS NOT NULL
    GROUP BY c.zip, d.vehicle_type
)
SELECT zip, vehicle_type AS most_common_type
FROM ranked_vehicle_types
WHERE rank_per_zip = 1
ORDER BY total_sales_per_zip DESC;


--Willis Ford Houston wants to get testimonies from satisfied families. Pull contact information for households that have 2 or more different customers living there.

SELECT 
    c.address, 
    c.zip, 
    c.city, 
    c.state, 
    c.first_initial, 
    c.last_name,
	c.email
FROM customer_data c
JOIN (
    SELECT address, zip, city, state
    FROM customer_data
    GROUP BY address, zip, city, state
    HAVING COUNT(DISTINCT driver_id) > 1
) household_data
ON c.address = household_data.address 
AND c.zip = household_data.zip 
AND c.city = household_data.city 
AND c.state = household_data.state
ORDER BY c.zip, c.address;
